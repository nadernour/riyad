     "title": "كان يعتكف العشر الأواخر",
     "matn": [
      {
       "role": "narration",
       "text": "عَنِ ابْنِ عُمَرَ رَضِيَ اللهُ عَنْهُمَا قَالَ: "
      },
      {
       "role": "speech",
       "text": "كَانَ رَسُولُ اللهِ ﷺ يَعتَكِفُ العَشْرَ الأَوَاخِرَ مِنْ رَمَضَانَ ."
      },
      {
       "role": "narration",
       "text": " مُتَّفَقٌ عَلَيْهِ."
      }
     ],
     "meanings": [],
     "benefits": [],
     "shared_with": null,
     "corrections": [],
     "notes": []
    },
    {
     "id": 1270,
     "old_id": 1266,
     "page": 892,
     "title": "كان يعتكف العشر الأواخر",
     "matn": [
      {
       "role": "narration",
       "text": "وَعَنْ عَائِشَةَ رَضِيَ اللهُ عَنْهَا: "
      },
      {
       "role": "speech",
       "text": "أَنَّ النَّبِيَّ ﷺ كَانَ يَعْتَكِفُ الْعَشْرَ الْأَوَاخِرَ مِنْ رَمَضَانَ حَتَّى تَوَفَّاهُ اللهُ ، ثُمَّ اعْتَكَفَ أَزْوَاجُهُ بَعْدَهُ ."
      },
      {
       "role": "narration",
       "text": " مُتَّفَقٌ عَلَيْهِ."
      }
     ],
     "meanings": [],
     "benefits": [],
     "shared_with": null,
     "corrections": [],
     "notes": []
    },
    {
     "id": 1271,
     "old_id": 1267,
     "page": 892,
     "title": "كان يعتكف في كل رمضان عشرة",
     "matn": [
      {
       "role": "narration",
       "text": "وَعَنْ أَبِي هُرَيْرَةَ رَضِيَ اللهُ عَنْهُ قَالَ: "
      },
      {
       "role": "speech",
       "text": "كانَ النَّبِيُّ ﷺ يَعْتَكِفُ فِي كُلِّ رَمَضَانٍ عَشْرَةَ أَيَّامٍ ، فَلَمًا كَانَ العَامُ الَّذِي قُبِضَ فِيهِ .. اعْتَكَفَ عِشْرِينَ يَوْماً ."
      },
      {
       "role": "narration",
       "text": " رَوَاهُ الْبُخَارِيُّ."
      }
     ],
