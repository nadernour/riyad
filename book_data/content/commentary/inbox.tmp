      {
        "term": "نفر",
        "meaning": "النفر بالتحريك عدة رجال من ثلاثة إلى عشرة ."
      },
      {
        "term": "فوقع في نفس رسول الله ما شاء الله أن يقع",
        "meaning": "أي من طرد المسلمين ، لما علم من ثبات إيمانهم ، وطمعاً في إسلام أئمة الشرك وإسلام قومهم نظير مجالستهم في يوم خاص بهم .",
        "in_text": "فَوقَعَ فِي نَفْسِ رَسُولِ اللهِ ﷺ ما شاءَ اللهُ أَن يقعَ"
      }
    ],
    "benefits": [
      "الفقراء والضعفاء كانوا أول من اعتنق الإسلام وصدق برسالة محمد ﷺ .",
      "يجب احترام الصالحين واجتناب ما يغضبهم ويؤذيهم ، وإن في إيذائهم وإغضابهم غضب الله .",
      "يجب أن يكون احترام الناس وتقديرهم لدينهم وإيمانهم لا لمالهم وجاههم .",
      "المساواة في القيمة الإنسانية مبدأ إسلامي طبق عملياً منذ الأيام الأولى من دعوة الإسلام .",
      "الإسلام دين الله تعالى لجميع الناس ، ولا فضل لأحد على آخر بمال أو جاه إلا بالتقوى والعمل ."
    ],
    "shared_with": [],
    "corrections": [],
