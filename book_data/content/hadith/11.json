{
 "old_id": 11,
 "title": "كتاب الحج",
 "chapters": [
  {
   "number": 233,
   "old_id": 229,
   "title": "باب وجوب الحج وفضله",
   "hadith": [
    {
     "id": 1272,
     "old_id": 1268,
     "page": 893,
     "title": "بني الإسلام على خمس",
     "matn": [
      {
       "role": "narration",
       "text": "وَعَنِ ابْنِ عُمَرَ رَضِيَ اللهُ عَنْهُمَا: "
      },
      {
       "role": "speech",
       "text": "أَنَّ رَسُولَ اللهِ ﷺ قَالَ: "
      },
      {
       "role": "prophet",
       "text": "«بُنِيَ الْإِسْلاَمُ عَلَى خَمْسٍ: شَهَادَةِ أَنْ لَا إلَهَ إ إلَّا اللهُ وَأَنَّ مُحَمَّداً رسُولُ اللهِ ، وَإِقَامِ الصَّلاةِ، وَإِيتَاءِ الزَّكَاةِ، وَحَجِّ البيْتِ، وَصَوْمِ رَمَضَانَ »"
      },
      {
       "role": "narration",
       "text": " مُتَّفَقٌ عَلَيْهِ."
      }
     ],
     "meanings": [],
     "benefits": [],
     "shared_with": null,
     "corrections": [],
     "notes": []
    },
    {
     "id": 1273,
     "old_id": 1269,
     "page": 894,
     "title": "لو قلت نعم لوجبت",
     "matn": [
      {
       "role": "narration",
       "text": "وَعَنْ أَبِي هُرَيْرَةَ رَضِيَ اللهُ عَنْهُ قَالَ: "
      },
      {
       "role": "speech",
       "text": "خَطَبَنَا رَسُولُ اللهِ ﷺ فَقَالَ: "
      },
      {
       "role": "prophet",
       "text": "«يَا أَيُّهَا النَّاسُ ؛ قَدْ فُرِضَ عَلَيْكُمُ الْحَجُّ .. فَحُجُّوا » "
      },
      {
       "role": "speech",
       "text": "فَقَالَ رَجُلٌ: أَكُلَّ عَامٍ يَا رَسُولَ اللهِ ؟ فَسَكَتَ ، حَتَّى قَالَهَا ثَلاَثاً ، فَقَالَ رَسُولُ اللهِ ﷺ: "
      },
      {
       "role": "prophet",
       "text": "« لَوْ قُلْتُ: نَعَمْ .. لَوَجَبَتْ ، وَلمَا اسْتَطَعْتُمْ » "
      },
      {
       "role": "speech",
       "text": "ثُمَّ قَالَ: "
      },
      {
       "role": "prophet",
       "text": "« ذَرُونِي مَا تَرَكْتُكُمْ ؛ فَإِنَّمَا هَلَكَ مَنْ كَانَ قَبْلَكُمْ بِكَثْرَةِ سُؤَالِهِمْ ، وَاخْتِلاَفِهِمْ عَلَى أَنْبِيَائِهِمْ ، فَإِذَا أَمَرْتُكُمْ بِشَيْءٍ .. فَأْتُوا مِنْهُ مَا اسْتَطَعْتُمْ ، وَإذَا نَهَيْتُكُمْ عَنْ شَيْءٍ .. فَدَعُوهُ »"
      },
      {
       "role": "narration",
       "text": " . رَوَاهُ مُسْلِمٌ ."
      }
     ],
     "meanings": [],
     "benefits": [],
     "shared_with": null,
     "corrections": [],
     "notes": []
    },
    {
     "id": 1274,
     "old_id": 1270,
     "page": 894,
     "title": "حج مبرور",
     "matn": [
      {
       "role": "narration",
       "text": "وَعَنْهُ قَالَ: "
      },
      {
       "role": "speech",
       "text": "سُئِلَ النَّبيُّ ﷺ: أَيُّ الْعَمَلِ أَفْضَلُ ؟ قَالَ: "
      },
      {
       "role": "prophet",
       "text": "« إِيمَانٌ بِاللهِ وَرَسُولِهِ» "
      },
      {
       "role": "speech",
       "text": "قِيَلَ: ثُمَّ مَاذَا ؟ قَالَ: "
      },
      {
       "role": "prophet",
       "text": "« الْجِهَادُ فِي سَبِيلِ اللهِ » "
      },
      {
       "role": "speech",
       "text": "قِيلَ: ثُمَّ مَاذَا ؟ قَالَ: "
      },
      {
       "role": "prophet",
       "text": "« حَجٌ مَبْرُورٌ »"
      },
      {
       "role": "narration",
       "text": " مُتَّفَقٌ عَلَيْهِ.\n"
      },
      {
       "role": "gloss",
       "text": "« المَبرُورُ»"
      },
      {
       "role": "narration",
       "text": " : هُوَ الَّذِي لاَ يَرْتَكِبُ صَاحِبُهُ فِيهِ مَعْصِيَةً ."
      }
     ],
     "meanings": [],
     "benefits": [],
     "shared_with": null,
     "corrections": [],
     "notes": []
    },
    {
     "id": 1275,
     "old_id": 1271,
     "page": 895,
     "title": "من حج فلم يرفث",
     "matn": [
      {
       "role": "narration",
       "text": "وَعَنْهُ قَالَ: "
      },
      {
       "role": "speech",
       "text": "سَمِعْتُ رَسُولَ اللهِ ﷺ يَقُولُ: "
      },
      {
       "role": "prophet",
       "text": "«مَنْ حَجَّ فَلَمْ يَرْفُثْ ، وَلَم يَفْسُقْ .. رَجَعَ كَيَوْمَ وَلَدتْهُ أُمُّهُ»"
      },
      {
       "role": "narration",
       "text": " . مُتَّفَقٌ عَلَيْهِ."
      }
     ],
     "meanings": [],
     "benefits": [],
     "shared_with": null,
     "corrections": [],
     "notes": []
    },
    {
     "id": 1276,
     "old_id": 1272,
     "page": 896,
     "title": "العمرة إلى العمرة كفارة",
     "matn": [
      {
       "role": "narration",
       "text": "وعَنْهُ: أَنَّ رَسُولَ اللهِ ﷺ قَالَ: "
      },
      {
       "role": "prophet",
       "text": "« الْعُمْرَةُ إِلَى الْعُمْرَةِ .. كَفَّارَةٌ لِمَا بَيْنَهُمَا ، وَالْحَجُّ الْمَبْرُورُ .. لَيْسَ لَهُ جَزَاءٌ إلَّا الْجَنَّةَ»"
      },
      {
       "role": "narration",
       "text": " مُتَّفَقٌ عَلَيْهِ."
      }
     ],
     "meanings": [],
     "benefits": [],
     "shared_with": null,
     "corrections": [],
     "notes": []
    },
    {
     "id": 1277,
     "old_id": 1273,
     "page": 896,
     "title": "لكن أفضل الجهاد حج مبرور",
     "matn": [
      {
       "role": "narration",
       "text": "وَعَنْ عَائِشَةَ رَضِيَ اللهُ عَنْهَا قَالَتْ: "
      },
      {
       "role": "speech",
       "text": "قُلْتُ : يا رَسُولَ اللهِ ؛ نَرَى الْجِهَادَ أفْضَلَ العَمَلِ ، أَفَلاَ نُجَاهِدُ ؟ فَقَالَ: "
      },
      {
       "role": "prophet",
       "text": "« لَكُنَّ أفْضَلُ الْجِهَادِ .. حَجٌّ مَبْرُورٌ »"
      },
      {
       "role": "narration",
       "text": " رَوَاهُ الْبُخَارِيُّ."
      }
     ],
     "meanings": [],
     "benefits": [],
     "shared_with": null,
     "corrections": [],
     "notes": []
    },
    {
     "id": 1278,
     "old_id": 1274,
     "page": 896,
     "title": "ما من يوم أكثر من أن يعتق",
     "matn": [
      {
       "role": "narration",
       "text": "وَعَنْهَا : أَنَّ رَسُولَ اللهِ ﷺ قَالَ: "
      },
      {
       "role": "prophet",
       "text": "« مَا مِنْ يَوْمٍ أَكْثَرَ مِنْ أَنْ يَعْتِقَ اللهُ فِيهِ عَبْداً مِنَ النَّارِ .. مِنْ يَوْمِ عَرَفَةَ »"
      },
      {
       "role": "narration",
       "text": " رَوَاهُ مُسْلِمٌ ."
      }
     ],
     "meanings": [],
     "benefits": [],
     "shared_with": null,
     "corrections": [],
     "notes": []
    },
    {
     "id": 1279,
     "old_id": 1275,
     "page": 896,
     "title": "عمرة في رمضان تعدل حجة",
     "matn": [
      {
       "role": "narration",
       "text": "وَعَنِ ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا : أَنَّ النَّبِيَّ ﷺ قَالَ: "
      },
      {
       "role": "prophet",
       "text": "« عُمْرَةٌ فِي رَمَضَانَ .. تَعدِلُ حَجَّةً ، أَوْ حَجَّةً مَعِي »"
      },
      {
       "role": "narration",
       "text": " مُتَّفَقٌ عَلَيْهِ."
      }
     ],
     "meanings": [],
     "benefits": [],
     "shared_with": null,
     "corrections": [],
     "notes": []
    },
    {
     "id": 1280,
     "old_id": 1276,
     "page": 897,
     "title": "نعم ، أفأحج عنه",
     "matn": [
      {
       "role": "narration",
       "text": "وَعَنْهُ : أَنَّ امْرَأَةً قَالَتْ: "
      },
      {
       "role": "speech",
       "text": "يَا رَسُولَ اللهِ ؛ إِنَّ فَرِيضَةَ اللهِ عَلَى عِبَادِهِ فِي الْحَجِّ أَدْرَكَتْ أَبِي شَيْخاً كَبِيراً ، لاَ يَثبُتُ عَلَى الرَّاحِلَةِ ، أَفَأَحُجُّ عَنْهُ ؟ قَالَ: "
      },
      {
       "role": "prophet",
       "text": "« نَعَمْ »"
      },
      {
       "role": "narration",
       "text": " مُتَّفَقٌ عَلَيْهِ."
      }
     ],
     "meanings": [],
     "benefits": [],
     "shared_with": null,
     "corrections": [],
     "notes": []
    },
    {
     "id": 1281,
     "old_id": 1277,
     "page": 897,
     "title": "حج عن أبيك و اعتمر",
     "matn": [
      {
       "role": "narration",
       "text": "وَعَنْ لَقِيطِ بْنِ عَامِرٍ رَضِيَ اللهُ عَنْهُ: أَنَّهُ أَتَى النَّبِيَّ ﷺ فَقَالَ: "
      },
      {
       "role": "speech",
       "text": "إِنَّ أَبِي شَيْخٌ كَبيرٌ لَا يَسْتَطِيعُ الْحَجَّ ، وَلَا الْعُمْرَةَ ، وَلَا الظَّعَنَ ؟"
      },
      {
       "role": "narration",
       "text": " قَالَ: "
      },
      {
       "role": "prophet",
       "text": "« حُجَّ عَنْ أَبِيكَ وَاعْتَمِرْ»"
      },
      {
       "role": "narration",
       "text": " . رَوَاهُ أَبُو دَاوُودَ ، وَالتِّرْمِذِيُّ وَقَالَ: حَدِيثٌ حَسَنٌ صَحِيحٌ."
      }
     ],
     "meanings": [],
     "benefits": [],
     "shared_with": null,
     "corrections": [],
     "notes": []
    },
    {
     "id": 1282,
     "old_id": 1278,
     "page": 898,
     "title": "حج بي مع الرسول في حجة الوداع",
     "matn": [
      {
       "role": "narration",
       "text": "وعَنِ السَّائِبِ بْنِ يَزِيدَ رَضِيَ اللهُ عَنْهُ قَالَ: "
      },
      {
       "role": "speech",
       "text": "حُجَّ بِي مَعَ رَسُولِ اللهِ ﷺ فِي حَجَّةِ الْوَدَاعِ وَأَنَا ابْنُ سَبْعِ سِنِينَ ."
      },
      {
       "role": "narration",
       "text": " رَوَاهُ الْبُخَارِيُّ."
      }
     ],
     "meanings": [],
     "benefits": [],
     "shared_with": null,
     "corrections": [],
     "notes": []
    },
    {
     "id": 1283,
     "old_id": 1279,
     "page": 898,
     "title": "نعم،و لك أجر",
     "matn": [
      {
       "role": "narration",
       "text": "وَعَنِ ابْنِ عَبَّاسٍ رَضَيَ اللهُ عَنْهُمَا : أَنَّ النَّبِيَّ ﷺ لَقِيَ رَكْباً بِالرَّوْحَاءِ فَقَالَ: "
      },
      {
       "role": "prophet",
       "text": "« مَنِ الْقَوْمُ ؟ »"
      },
      {
       "role": "narration",
       "text": " قَالُوا: "
      },
      {
       "role": "speech",
       "text": "الْمُسْلِمُونَ ،"
      },
      {
       "role": "narration",
       "text": " قَالُوا: "
      },
      {
       "role": "speech",
       "text": "مَنْ أَنْتَ ؟"
      },
      {
       "role": "narration",
       "text": " قَالَ: "
      },
      {
       "role": "prophet",
       "text": "« رَسُولُ اللهِ »"
      },
      {
       "role": "narration",
       "text": " فَرَفَعَتِ امْرَأَةٌ صَبِيّاً فَقَالَتْ: "
      },
      {
       "role": "speech",
       "text": "أَلِهَذا حَجٌّ ؟"
      },
      {
       "role": "narration",
       "text": " قَالَ: "
      },
      {
       "role": "prophet",
       "text": "« نَعَمْ، وَلَكِ أَجْرٌ »"
      },
      {
       "role": "narration",
       "text": " رَوَاهُ مُسْلِمٌ ."
      }
     ],
     "meanings": [],
     "benefits": [],
     "shared_with": null,
     "corrections": [],
     "notes": []
    },
    {
     "id": 1284,
     "old_id": 1280,
     "page": 899,
     "title": "أن الرسول حج على رحل",
     "matn": [
      {
       "role": "narration",
       "text": "وَعَنْ أَنَسٍ رَضِيَ اللهُ عَنْهُ: "
      },
      {
       "role": "speech",
       "text": "أَنَّ رَسُولَ اللهِ ﷺ حَجَّ عَلَى رَحْلٍ، وَكَانَتْ زامِلَتَهُ"
      },
      {
       "role": "narration",
       "text": " . رَوَاهُ الْبُخَارِيُّ."
      }
     ],
     "meanings": [],
     "benefits": [],
     "shared_with": null,
     "corrections": [],
     "notes": []
    },
    {
     "id": 1285,
     "old_id": 1281,
     "page": 899,
     "title": "كانت عكاظ و مجنة و ذو المجاز",
     "matn": [
      {
       "role": "narration",
       "text": "وَعَنِ ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا قَالَ : "
      },
      {
       "role": "speech",
       "text": "كَانَتْ عُكَاظُ وَمِجَنَّةُ وَذُو الْمَجَازِ أَسْواقاً فِي الْجَاهِلِيَّةِ ، فَتَأَثَّمُوا أَنْ يَتَّجِرُوا فِي الْموَاسِمِ ، فَنَزَلَتْ: "
      },
      {
       "role": "prophet",
       "text": "﴿لَيْسَ عَلَيْكُمْ جُنَاحٌ أَن تَبْتَغُوا فَضْلًا مِّن رَّبِّكُمْ﴾ "
      },
      {
       "role": "speech",
       "text": "فِي مَوَاسِمِ الْحَجِّ ."
      },
      {
       "role": "narration",
       "text": " رَوَاهُ الْبُخَارِيُّ."
      }
     ],
     "meanings": [],
     "benefits": [],
     "shared_with": null,
     "corrections": [],
     "notes": []
    }
   ]
  }
 ]
}
